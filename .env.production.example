# انسخه إلى .env.production واملأ كل قيمة CHANGE_ME من مدير الأسرار. لا تلتزم .env.production في Git.
APP_NAME="Sooqna"
APP_ENV=production
APP_KEY=                      # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://api.sooqna.example
APP_VERSION=1.0.0

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_MAINTENANCE_DRIVER=cache

HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
LOG_REQUEST_ID=true

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sooqna
DB_USERNAME=sooqna
DB_PASSWORD=CHANGE_ME
DB_SEARCH_PATH=public

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379
REDIS_HORIZON_PREFIX=sooqna_horizon:

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=sooqna-media
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=https://media.sooqna.example

MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@sooqna.example"
MAIL_FROM_NAME="${APP_NAME}"

# نطاق واجهة الويب فقط — لا *
CORS_ALLOWED_ORIGINS="https://app.sooqna.example"
SANCTUM_TOKEN_EXPIRATION=129600

# أول مشرف للوحة /admin — يُنشأ بـ php artisan db:seed --class=AdminSeeder ثم احذف القيم
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="الإدارة"

HTTP_PORT=80
AUTH_MODEL=App\Modules\Identity\Models\User
