APP_NAME="Sooqna"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# الواجهة عربية — أخطاء الـAPI عربية افتراضيًا
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=cache

# Argon2id لكلمات المرور
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_REQUEST_ID=true

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sooqna
DB_USERNAME=sooqna
DB_PASSWORD=sooqna_local
DB_SEARCH_PATH=public

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# الصور على تخزين S3-متوافق (MinIO محليًا)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=sooqna
AWS_SECRET_ACCESS_KEY=sooqna_local
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=sooqna-media
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=

QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_HORIZON_PREFIX=sooqna_horizon:

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@sooqna.local"
MAIL_FROM_NAME="${APP_NAME}"

# الواجهة المحلية (Flutter web dev) — عدّل عند النشر
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080,http://localhost:57420"

# Sanctum: انتهاء التوكن بعد 90 يومًا خمول (دقائق = 129600)
SANCTUM_TOKEN_EXPIRATION=129600

VITE_APP_NAME="${APP_NAME}"
